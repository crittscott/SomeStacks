{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/crittscott/SomeStacks/tree/1.21.1",
    "sources": "https://github.com/crittscott/SomeStacks/tree/1.21.1",
    "issues": "https://github.com/crittscott/SomeStacks/issues"
  },
  "license": "${mod_license}",
  "icon": "assets/somestacks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.crittscott.somestacks.SomeStacksFabric"
    ],
    "client": [
      "com.github.crittscott.somestacks.SomeStacksFabricClient"
    ]
  },
  "mixins": [
    "somestacks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "ftbchunks": "*"
  }
}
