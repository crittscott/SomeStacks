{
  "schemaVersion": 1,
  "id": "somestacks",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.crittscott.somestacks.SomeStacksFabric"
    ],
    "client": [
      "com.github.crittscott.somestacks.SomeStacksFabricClient"
    ]
  },
  "mixins": [
    "somestacks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "architectury": ">=${architectury_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  }
}
