{
  "_comment": "Simple string format uses texture as-is (no tinting)",
  "minecraft:iron_ingot": "somestacks:block/minecraft/iron_ingot",
  "minecraft:brick": "minecraft:block/bricks",
  "minecraft:nether_brick": "minecraft:block/nether_bricks",

  "_comment2": "Object format allows texture + optional tint color",
  "minecraft:gold_ingot": {
    "texture": "somestacks:block/minecraft/base_ingot",
    "tint": "#FFD700"
  },
  "minecraft:copper_ingot": {
    "texture": "somestacks:block/minecraft/base_ingot",
    "tint": "#B87333"
  },
  "minecraft:netherite_ingot": {
    "texture": "somestacks:block/minecraft/base_ingot",
    "tint": "#4C4C4C"
  }
}
